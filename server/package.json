{
  "name": "yaos-server-selfhosted",
  "version": "0.4.0",
  "private": true,
  "description": "Self-hosted YAOS server using Bun, PostgreSQL, and S3-compatible storage",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun run src/db/migrate.ts",
    "validate": "bun run src/test/validate.ts",
    "test:integration": "bun run src/test/integration.ts",
    "test:integration:selfhosted": "bun run src/test/integration.ts",
    "test:smoke": "bun run src/test/smoke.ts",
    "test:s3": "bun run src/test/s3-snapshot.ts",
    "test:s3:stream": "bun run src/test/s3-stream.ts",
    "test:snapshot:e2e": "bun run src/test/snapshot-e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.525.0",
    "@aws-sdk/lib-storage": "^3.525.0",
    "fflate": "^0.8.2",
    "lib0": "^0.2.117",
    "pg": "^8.13.0",
    "ws": "^8.18.0",
    "y-partyserver": "2.1.2",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.10",
    "bun-types": "^1.3.12",
    "typescript": "^5.8.3",
    "wrangler": "^3.114.0"
  }
}
