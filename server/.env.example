# YAOS Self-Hosted Server Configuration

# Server Configuration
PORT=3000

# Database (PostgreSQL) - Required
DATABASE_URL=postgresql://user:password@localhost:5432/yaos

# Optional: Environment token for authentication (bypasses claim flow)
# SYNC_TOKEN=your-secure-random-token-here

# Optional: Canonical repository reference
YAOS_CANONICAL_REPO=kavinsood/yaos

# Optional: S3-Compatible Object Storage (for attachments and snapshots)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=yaos-storage
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
