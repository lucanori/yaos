{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["bun-types", "pg", "ws", "node"],
    "typeRoots": ["./node_modules/@types", "./node_modules"]
  },
  "include": ["src/**/*.ts"],
	"exclude": ["src/test/**"]
}
